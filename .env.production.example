# Configuracao do DEPLOY. Copie para .env.production (ignorado pelo git) e preencha.
#
# Arquivo separado do .env de propósito: o .env aponta para o Postgres local da sua máquina; este
# aponta para o banco do demo. Misturar os dois faria o desenvolvimento escrever em producao.

# --- Banco (Supabase) ---
# Use o endpoint do POOLER (Supavisor), nao a conexao direta: a direta e IPv6 em projetos novos e
# varios hosts nao tem saida IPv6. Em transaction mode o prepared statement do driver quebra, dai o
# prepareThreshold=0. Pegue em: Supabase -> Project Settings -> Database -> Connection pooling.
DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:6543/postgres?prepareThreshold=0
DB_USERNAME=postgres.SEU_PROJETO
DB_PASSWORD=

# 5 e o teto seguro no free tier do Supabase, que cobra conexao.
DB_POOL_SIZE=5

# --- IA ---
IA_PROVEDOR=gemini
GEMINI_API_KEY=

# --- Front ---
# Origem exata do front (esquema + host), separada por virgula se houver mais de uma. Sem isto o
# navegador bloqueia as chamadas. Precisa ser subdominio do MESMO dominio registravel da API, senao
# o cookie de sessao (SameSite=Lax) nao viaja.
CORS_ALLOWED_ORIGINS=https://seudominio.com
