# Copie este arquivo para .env e preencha com os valores reais.
# O .env é ignorado pelo git; este .env.example é versionado apenas como referência.

DB_USERNAME=postgres
DB_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=

# Usuário HTTP Basic do perfil dev (DevSecurityConfig). Se ausente, o padrão é dev/dev.
DEV_USER=dev
DEV_PASSWORD=dev
