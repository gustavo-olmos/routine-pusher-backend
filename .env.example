# Copie este arquivo para .env e preencha com os valores reais.
# O .env é ignorado pelo git; este .env.example é versionado apenas como referência.

# --- Banco ---
# Local: pode deixar DB_URL em branco, o default aponta para o Postgres da máquina.
# Supabase: use o endpoint do POOLER (Supavisor), não a conexão direta — a direta é IPv6 em
# projetos novos e vários hosts não têm saída IPv6. Em transaction mode o prepared statement do
# driver quebra, daí o prepareThreshold=0:
#   DB_URL=jdbc:postgresql://aws-0-<regiao>.pooler.supabase.com:6543/postgres?prepareThreshold=0
#   DB_USERNAME=postgres.<referencia-do-projeto>
DB_URL=
DB_USERNAME=postgres
DB_PASSWORD=

# Conexões do pool. O free tier do Supabase tem orçamento pequeno: use 5.
DB_POOL_SIZE=10

# --- Schema ---
# O Flyway cria e versiona o schema; o Hibernate apenas valida. Não troque para update/create-drop
# em ambiente com dado real: as duas opções divergem em silêncio do que está versionado.
JPA_DDL_AUTO=validate
FLYWAY_ENABLED=true

# Logar todo SQL. Deixe false fora da máquina de desenvolvimento: é volume de log e vaza conteúdo.
JPA_SHOW_SQL=true

# --- Agendamento (Quartz) ---
# O job store é JDBC: os triggers vivem no banco e sobrevivem a restart. As tabelas vêm da migração
# V2__quartz.sql, não do próprio Quartz.
QUARTZ_THREADS=5

# Deixe false com uma instância só. Ligue JUNTO com a segunda instância: com duas rodando e
# clustered=false, as duas disparam o mesmo lembrete.
QUARTZ_CLUSTERED=false

# --- OAuth / integrações ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chave da API da Anthropic (console.anthropic.com -> API Keys). Sem ela o endpoint de chat
# responde erro de indisponibilidade; o resto da aplicacao sobe normalmente.
ANTHROPIC_API_KEY=
# claude-haiku-4-5 por padrao; claude-sonnet-5 para mais qualidade a ~2x o custo.
ANTHROPIC_MODEL=claude-haiku-4-5

# --- CORS / front ---
# Origens autorizadas a chamar a API de um navegador, separadas por vírgula. Precisa ser a origem
# exata do front (esquema + host + porta). O cookie de sessão é SameSite=Lax: front e API devem
# morar no mesmo domínio registrável (ex.: seudominio.com e api.seudominio.com).
#   CORS_ALLOWED_ORIGINS=https://seudominio.com
CORS_ALLOWED_ORIGINS=http://localhost:4200
