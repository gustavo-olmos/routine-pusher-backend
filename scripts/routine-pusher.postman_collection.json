            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Daily\",\n  \"descricao\": \"De segunda a sexta as 09:00\",\n  \"categoriaId\": {{categoriaId}},\n  \"recorrencia\": {\n    \"diasDaSemana\": [\n      \"SEGUNDA\",\n      \"TERCA\",\n      \"QUARTA\",\n      \"QUINTA\",\n      \"SEXTA\"\n    ]\n  },\n  \"notificacao\": {\n    \"metodo\": [\n      \"e-mail\"\n    ],\n    \"horario\": \"09:00\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const l = pm.response.json();",
                  "pm.test('guardou os cinco dias', () =>",
                  "    pm.expect(l.recorrencia.diasDaSemana).to.have.lengthOf(5));",
                  "pm.test('projeta uma semana util, sem sabado nem domingo', () => {",
                  "    pm.expect(l.proximasExecucoes).to.have.lengthOf(5);",
                  "    l.proximasExecucoes.forEach(d => {",
                  "        const dia = new Date(d).getDay();",
                  "        pm.expect(dia, 'dia ' + d).to.be.within(1, 5);",
                  "        pm.expect(d.slice(11, 16)).to.eql('09:00');",
                  "    });",
                  "});"
                ]
              }
            }
          ]
