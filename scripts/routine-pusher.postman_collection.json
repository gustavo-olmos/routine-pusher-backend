            "url": {
              "raw": "{{baseUrl}}/api/v1/lembrete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "lembrete"
              ]
            },
            "description": "Recorrencia por intervalo exige notificacao.dataInicio: e a base do calculo da proxima execucao. Sem quantidade nem dataFim, repete para sempre.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Beber água\",\n  \"descricao\": \"Hidratação a cada 2 minutos\",\n  \"categoriaId\": {{categoriaId}},\n  \"recorrencia\": {\n    \"intervaloMinutos\": 2\n  },\n  \"notificacao\": {\n    \"metodo\": [\n      \"pop-up\"\n    ],\n    \"dataInicio\": \"{{agora}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const l = pm.response.json();",
                  "pm.collectionVariables.set('lembreteId', l.id);",
                  "pm.test('agendou no futuro', () =>",
                  "    pm.expect(new Date(l.notificacao.proximaExecucao)).to.be.greaterThan(new Date()));",
                  "pm.test('projeta as proximas 5 execucoes, em ordem e no futuro', () => {",
                  "    pm.expect(l.proximasExecucoes).to.have.lengthOf(5);",
                  "    const datas = l.proximasExecucoes.map(d => new Date(d).getTime());",
                  "    pm.expect(datas[0]).to.be.greaterThan(Date.now());",
                  "    datas.forEach((data, i) => { if (i) pm.expect(data).to.be.greaterThan(datas[i - 1]); });",
                  "});",
                  "pm.test('primeira execucao projetada e a que foi agendada', () =>",
                  "    pm.expect(l.proximasExecucoes[0]).to.eql(l.notificacao.proximaExecucao));"
                ]
              }
            }
          ]
        },
