              ],
              "path": [
                "api",
                "v1",
                "categoria"
              ],
              "query": [
                {
                  "key": "sortInfo",
                  "value": "nome"
                },
                {
                  "key": "decrescente",
                  "value": "false"
                }
              ]
            },
            "description": "sortInfo e decrescente sao obrigatorios; sem eles a API responde 400."
          },
          "response": [],
          "event": [
            {
